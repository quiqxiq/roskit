REDIS_DB=0
REDIS_TEST=1

# InfluxDB 3 (docker-compose.dev.yml → localhost)
INFLUXDB_URL=http://localhost:8181
INFLUXDB_TOKEN=
INFLUXDB_DATABASE=mikhmon

