# Test environment variables
# Source this before running integration tests:
#   PowerShell: Get-Content .env.test | ForEach-Object { if ($_ -match '^([^#].+?)=(.*)$') { [System.Environment]::SetEnvironmentVariable($matches[1], $matches[2], 'Process') } }
#   Bash:       set -a && source .env.test && set +a

# MikroTik (real device)
MIKROTIK_HOST=192.168.233.1:8728
MIKROTIK_USER=admin
MIKROTIK_PASS=r00t
MIKROTIK_ID=test

# PostgreSQL (docker-compose.dev.yml → localhost)
DB_HOST=localhost
DB_PORT=5432
DB_USER=mikhmon
DB_PASSWORD=mikhmon
DB_NAME=mikhmon
DB_SSLMODE=disable

# Redis (docker-compose.dev.yml → localhost)
