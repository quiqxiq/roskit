# Application
PORT=8080
APP_ENV=development

# Security
JWT_SECRET=change-me-in-production-use-a-32-byte-string
JWT_REFRESH_SECRET=change-me-in-production-use-a-different-32-byte-string
AES_ENCRYPTION_KEY=32-byte-base64-encoded-key

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=mikhmon
DB_PASSWORD=mikhmon
DB_NAME=mikhmon
DB_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# InfluxDB 3 Core (optional — time-series metrics)
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=my-super-secret-auth-token
INFLUXDB_DATABASE=mikhmon
